# Shared server-side chat model (OpenAI-compatible /v1 endpoint)
APP_DOMAIN=rag.example.com
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=

# Qdrant Cloud: copy the cluster URL and API key from its dashboard.
# For local Qdrant, use http://127.0.0.1:6333 and leave QDRANT_API_KEY empty.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# On a small VM use an OpenAI-compatible embeddings API; set its exact model name.
# Use local only when the host can run SentenceTransformer.
EMBEDDING_PROVIDER=api
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
STUDENT_USERNAME=student
STUDENT_PASSWORD=
